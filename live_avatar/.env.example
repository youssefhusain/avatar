# انسخ الملف ده لـ .env واملى المفتاح بتاعك
# متسيبش .env يترفع على git (هو متضاف في .gitignore)

# --- Groq (الافتراضي: STT + LLM + TTS كلهم من هنا) ---
GROQ_API_KEY=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
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_TTS_MODEL=canopylabs/orpheus-arabic-saudi
# الأصوات المتاحة: fahad, sultan, abdullah (رجالي) - lulwa, noura, aisha (حريمي)
GROQ_TTS_VOICE=fahad

# --- Gemini Live (اختياري - صوت لصوت مباشر، لو حبيت ترجع تستخدمه) ---
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_VOICE_NAME=Puck

# مسارات موديل FlashTalk
FLASHTALK_CKPT_DIR=./models/SoulX-FlashTalk-14B
WAV2VEC_DIR=./models/chinese-wav2vec2-base

# صورة الأفاتار اللي هيتحرك (وش ثابت)
AVATAR_IMAGE=./examples/man.png

# فولدر حفظ فيديوهات المحادثة الناتجة
OUTPUT_DIR=./live_avatar/output
