# انسخ الملف ده لـ .env واملى المفتاح بتاعك
# متسيبش .env يترفع على git (هو متضاف في .gitignore تحت)

GEMINI_API_KEY=AQ.Ab8RN6Lxh8q1vEX0BfHTCZ77yWZrm7Q0wau9A1GQm-BtXiW08A

# اختياري: اسم موديل الـ Live API (الافتراضي شغال كويس)
